# Reference only: Spring Boot reads environment variables, not this file automatically.
# The demo profile needs none of these values and uses an isolated in-memory database.
EVENTLITE_ADMIN_USERNAME=
EVENTLITE_ADMIN_PASSWORD=
EVENTLITE_DATASOURCE_URL=jdbc:h2:file:./db/eventlite-dev
EVENTLITE_DATASOURCE_USERNAME=h2
EVENTLITE_DATASOURCE_PASSWORD=
EVENTLITE_DDL_AUTO=update
EVENTLITE_MASTODON_INSTANCE=
EVENTLITE_MASTODON_TOKEN=
EVENTLITE_MASTODON_ACCOUNT_ID=
EVENTLITE_MAPBOX_TOKEN=
EVENTLITE_MAPBOX_PUBLIC_TOKEN=
